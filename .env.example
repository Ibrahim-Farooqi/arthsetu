# --- Frontend ---
# Copy to .env (local dev) and also set these as Environment Variables in
# your Vercel project (Project Settings -> Environment Variables) for
# Production + Preview.

# Supabase project (Dashboard -> Project Settings -> API).
# The anon key is safe to expose in the frontend bundle by design.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# FastAPI backend base URL (including the /api/v1 prefix)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# --- Backend ---
ENV=development

# For local/demo, leave as-is (SQLite, zero setup).
DATABASE_URL=sqlite+aiosqlite:///./arthsetu.db

# Generate a real secret for anything beyond local dev:
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Supabase Auth ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MARKET_DATA_PROVIDER=mock
